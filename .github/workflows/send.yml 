name: compliments
on:
  schedule:
    - cron: '0 6 * * *'    # 09:00 МСК
    - cron: '30 10 * * *'  # 13:30 МСК
    - cron: '0 15 * * *'   # 18:00 МСК
    - cron: '30 19 * * *'  # 20:30 МСК
  workflow_dispatch:

jobs:
  send:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: true
          fetch-depth: 0
      - name: Run bot
        env:
          BOT_TOKEN: ${{ secrets.BOT_TOKEN }}
        run: python3 bot.py
